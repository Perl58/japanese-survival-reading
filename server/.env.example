# Japanese Survival Reading — server environment variables
# ─────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. All values below are optional — the app runs with just VOICEVOX
#    installed and running locally, no keys required.

# Server port (default: 8083)
PORT=8083

# ── VOICEVOX voice (teacher character) ──────────────────────────────────
# Requires VOICEVOX running locally: download from
# https://voicevox.hiroshiba.jp and leave it open (or run the standalone
# "voicevox_engine" package). If it's not running, /api/tts fails and the
# app falls back to captions + mouth-flap only — no other feature depends
# on this.
VOICEVOX_ENGINE_URL=http://127.0.0.1:50021
VOICEVOX_SPEAKER_NAME=春日部つむぎ
VOICEVOX_SPEAKER_STYLE=ノーマル
